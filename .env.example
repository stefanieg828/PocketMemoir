# Client build flags (VITE_* only). Copy to `.env` for local overrides.
# Pages deploy sets VITE_STRIPE_PAYMENT_LINK in .github/workflows/deploy-pages.yml;
# unlock.ts also falls back to the live buy link when unset.

# Stripe Payment Link (semi-public buy button URL — OK to commit in examples).
VITE_STRIPE_PAYMENT_LINK=https://buy.stripe.com/7sY8wR0jHgGh8FWbFF6Vq00

# Google Analytics 4 Measurement ID (optional). Leave empty / unset → no gtag.
# TODO: Stefanie creates a GA4 web stream for pocketmemoir.fun, then sets this
# locally and as GitHub Actions secret VITE_GA_MEASUREMENT_ID (see docs/analytics.md).
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
